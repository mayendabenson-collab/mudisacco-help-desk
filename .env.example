# Application
APP_ENV=prod
APP_SECRET=change-me-to-a-strong-random-32-char-secret
APP_NAME="NZERU Help Desk"
APP_SHORT_NAME="NZERU"
APP_TAGLINE="Help Desk"
APP_LOGO_PATH="assets/styles/logonzeru.png"

# Database (PostgreSQL on Railway)
# Railway auto-injects DATABASE_URL when you add the PostgreSQL plugin
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16.0.0&charset=utf8"

# Messenger (use sync for simplicity; or configure a real transport)
MESSENGER_TRANSPORT_DSN=sync://

# Lock (flock=local file lock, fine for single-instance Railway deploys)
LOCK_DSN=flock

# Mailer
# Use null transport to disable email, or configure SMTP / Postmark / Mailgun etc.
# Format: smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=noreply@example.com
MAILER_FROM_NAME="NZERU Help Desk"

ADMIN_EMAIL=mayendajabulani@gmail.com
ADMIN_PASSWORD=axxz1234
