{% extends 'base.html.twig' %}

{% block title %}
    {{ linkData.purpose == 'reset' ? 'Password Reset Link' : 'Account Setup Link' }} | {{ app_name }}
{% endblock %}
{% block page_heading %}
    {{ linkData.purpose == 'reset' ? 'Password Reset Link' : 'Account Setup Link' }}
{% endblock %}

{% block topbar_actions %}
    {% include 'components/_button_link.html.twig' with { href: path('admin_staff_index'), label: 'Back to staff list', variant: 'secondary' } only %}
{% endblock %}

{% block body %}
<section class="page-section panel-section" style="max-width: 640px;">
    <p class="section-kicker">One-time secure link</p>
    <h2>Send this link to {{ linkData.name }}</h2>
    <p class="muted">{{ linkData.email }}</p>

    <div class="alert alert--error" style="margin-bottom:1.5rem; display:flex; align-items:flex-start; gap:10px;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0; margin-top:2px;">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <div>
            <strong>Security notice:</strong>
            This one-time link expires after 1 hour. Use the email button below to send a fresh link
            directly to the employee, or copy this link and share it privately. Do not post it in a
            shared document or group chat.
        </div>
    </div>

    <div class="form-field" style="margin-bottom:1.5rem;">
        <label style="font-weight:600;display:block;margin-bottom:.4rem;">
            {{ linkData.purpose == 'reset' ? 'Password reset link' : 'Account setup link' }}
        </label>
        <div style="display:flex;gap:.5rem;align-items:stretch;">
            <input
                id="setup-link-input"
                class="input"
                type="text"
                value="{{ linkData.url }}"
                readonly
                style="flex:1;font-size:.85rem;font-family:monospace;"
                onclick="this.select()"
            >
            <button
                class="button button--primary"
                type="button"
                id="copy-btn"
                onclick="copyLink()"
                style="white-space:nowrap;"
            >Copy link</button>
        </div>
        <p class="muted" style="margin-top:.4rem;font-size:.8rem;">Click the field or button to copy.</p>
    </div>

    <dl class="detail-list" style="margin-bottom:1.5rem;">
        <div><dt>Employee</dt><dd>{{ linkData.name }}</dd></div>
        <div><dt>Link purpose</dt><dd>{{ linkData.purpose == 'reset' ? 'Password reset' : 'First-time account setup' }}</dd></div>
        <div><dt>Expiry</dt><dd>1 hour from generation</dd></div>
    </dl>

    <div class="form-actions">
        {% if linkData.employee_id is defined %}
            <form method="post" action="{{ path('admin_staff_send_setup_link', { id: linkData.employee_id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('staff_setup_email_' ~ linkData.employee_id) }}">
                <input type="hidden" name="purpose" value="{{ linkData.purpose }}">
                <button class="button button--primary" type="submit">Email fresh link</button>
            </form>
        {% endif %}
        <a class="button button--secondary" href="{{ path('admin_staff_index') }}">Go to staff list</a>
    </div>
</section>

<script>
function copyLink() {
    const input = document.getElementById('setup-link-input');
    const btn = document.getElementById('copy-btn');
    input.select();
    if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(input.value).then(() => {
            btn.textContent = '✓ Copied!';
            setTimeout(() => { btn.textContent = 'Copy link'; }, 2500);
        });
    } else {
        document.execCommand('copy');
        btn.textContent = '✓ Copied!';
        setTimeout(() => { btn.textContent = 'Copy link'; }, 2500);
    }
}
</script>
{% endblock %}
