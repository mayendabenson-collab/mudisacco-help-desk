<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('assets/styles/app.css') }}">
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" aria-label="Primary navigation">
            <a class="brand" href="{{ path('app_dashboard') }}">
                {% if app_logo_path is defined and app_logo_path %}
                    {% set logoSrc = app_logo_path matches '/logonzeru/' ? 'assets/styles/logonzeru-icon.png' : app_logo_path %}
                    <img src="{{ asset(logoSrc) }}" alt="{{ app_short_name|default(app_name) }} logo" class="brand-logo">
                {% else %}
                    <span class="brand-mark">{{ app_short_name|default('NZ')|slice(0, 1)|upper }}</span>
                {% endif %}
                <span>
                    <strong>{{ app_short_name|default(app_name) }}</strong>
                    <small>{{ app_tagline|default('Help Desk') }}</small>
                </span>
            </a>

            <nav class="nav-list">
                {% if app.user %}
                    {# Create Ticket — prominent top item #}
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_SUPERVISOR') or is_granted('ROLE_MEMBER') or app.user.hasPermission('create_tickets') %}
                        <a class="nav-item nav-item--create{% if app.request.attributes.get('_route') == 'ticket_new' %} is-active{% endif %}"
                           href="{{ path('ticket_new') }}">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                            </svg>
                            Create Ticket
                        </a>
                    {% endif %}

                    <span class="nav-section-label">Workspace</span>

                    <a class="nav-item{% if app.request.attributes.get('_route') == 'app_dashboard' %} is-active{% endif %}"
                       href="{{ path('app_dashboard') }}">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                            <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                        </svg>
                        Dashboard
                    </a>

                    <a class="nav-item{% if app.request.attributes.get('_route') starts with 'ticket_' and app.request.attributes.get('_route') != 'ticket_new' %} is-active{% endif %}"
                       href="{{ path('ticket_index') }}">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
                            <rect x="9" y="3" width="6" height="4" rx="1"/>
                            <line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="12" y2="16"/>
                        </svg>
                        Ticket Queue
                    </a>

                    {% if is_granted('ROLE_STAFF') or is_granted('ROLE_SUPERVISOR') or is_granted('ROLE_ADMIN') %}
                        <a class="nav-item{% if app.request.attributes.get('_route') starts with 'notification_' %} is-active{% endif %}"
                           href="{{ path('notification_index') }}">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                            </svg>
                            Notifications
                        </a>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="nav-item{% if app.request.attributes.get('_route') starts with 'report_' or app.request.attributes.get('_route') == 'staff_performance_report' %} is-active{% endif %}"
                           href="{{ path('report_overview') }}">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 19V5"/><path d="M4 19h16"/><path d="M7 16v-4"/><path d="M12 16V8"/><path d="M17 16V5"/>
                            </svg>
                            Reports
                        </a>
                    {% endif %}

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="nav-divider"></div>
                        <span class="nav-section-label">Administration</span>

                        <a class="nav-item{% if app.request.attributes.get('_route') starts with 'admin_department' %} is-active{% endif %}"
                           href="{{ path('admin_department_index') }}">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                                <polyline points="9 22 9 12 15 12 15 22"/>
                            </svg>
                            Departments
                        </a>

                        <a class="nav-item{% if app.request.attributes.get('_route') starts with 'admin_category' %} is-active{% endif %}"
                           href="{{ path('admin_category_index') }}">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20.59 13.41L10.59 3.41a2 2 0 0 0-2.83 0L3.41 8.77a2 2 0 0 0 0 2.83l10 10a2 2 0 0 0 2.83 0l4.36-4.36a2 2 0 0 0 0-2.83z"/>
                                <circle cx="7" cy="7" r="1" fill="currentColor"/>
                            </svg>
                            Categories
                        </a>

                        <a class="nav-item{% if app.request.attributes.get('_route') starts with 'admin_sla' %} is-active{% endif %}"
                           href="{{ path('admin_sla_index') }}">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="9"/>
                                <polyline points="12 7 12 12 15.5 14"/>
                            </svg>
                            SLA Rules
                        </a>

                        <a class="nav-item{% if app.request.attributes.get('_route') starts with 'admin_staff' %} is-active{% endif %}"
                           href="{{ path('admin_staff_index') }}">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                            Staff
                        </a>

                        <a class="nav-item{% if app.request.attributes.get('_route') starts with 'admin_members' %} is-active{% endif %}"
                           href="{{ path('admin_members_index') }}">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4"/>
                                <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
                            </svg>
                            Members
                        </a>

                        {% if app.user.hasPermission('view_audit_log') %}
                            <a class="nav-item{% if app.request.attributes.get('_route') starts with 'admin_audit' %} is-active{% endif %}"
                               href="{{ path('admin_audit_index') }}">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2l7 4v5c0 4.8-3 9-7 11-4-2-7-6.2-7-11V6z"/>
                                    <polyline points="9 12 11 14 15 10"/>
                                </svg>
                                Audit Log
                            </a>
                        {% endif %}

                    {% else %}
                        {% if app.user.hasPermission('view_audit_log') %}
                            <a class="nav-item{% if app.request.attributes.get('_route') starts with 'admin_audit' %} is-active{% endif %}"
                               href="{{ path('admin_audit_index') }}">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2l7 4v5c0 4.8-3 9-7 11-4-2-7-6.2-7-11V6z"/>
                                </svg>
                                Audit Log
                            </a>
                        {% endif %}
                    {% endif %}

                    <div class="nav-divider"></div>

                    <a class="nav-item" href="{{ path('app_logout') }}">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                        Sign out
                    </a>

                {% else %}
                    <a class="nav-item{% if app.request.attributes.get('_route') == 'app_login' %} is-active{% endif %}"
                       href="{{ path('app_login') }}">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                            <polyline points="10 17 15 12 10 7"/>
                            <line x1="15" y1="12" x2="3" y2="12"/>
                        </svg>
                        Sign in
                    </a>
                {% endif %}
            </nav>
        </aside>

        <div class="workspace">
            <header class="topbar">
                <div>
                    <p class="eyebrow">Customer service management</p>
                    <h1>{% block page_heading %}{{ app_name }}{% endblock %}</h1>
                </div>
                {% block topbar_actions %}{% endblock %}
            </header>

            <main class="content">
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert--{{ label == 'error' ? 'error' : 'success' }}">
                            {% if label == 'error' %}
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex-shrink:0;margin-top:1px">
                                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                                </svg>
                            {% else %}
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="flex-shrink:0;margin-top:1px">
                                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                                </svg>
                            {% endif %}
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}
                {% endfor %}

                {% block body %}{% endblock %}
            </main>
        </div>
    </div>
</body>
</html>