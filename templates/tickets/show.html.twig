{% extends 'base.html.twig' %}

{% block title %}{{ ticket.reference }} | {{ app_name }}{% endblock %}
{% block page_heading %}{{ ticket.reference }}{% endblock %}

{% block topbar_actions %}
    {% include 'components/_button_link.html.twig' with { href: path('ticket_index'), label: 'Back to queue', variant: 'secondary' } only %}
{% endblock %}

{% block body %}
    {% set statusTones = {'OPEN': 'warning', 'IN_PROGRESS': 'success', 'WAITING_FOR_MEMBER': 'warning', 'RESOLVED': 'neutral', 'CLOSED': 'neutral', 'REOPENED': 'warning'} %}
    {% set slaTones = {'ON_TRACK': 'success', 'DUE_SOON': 'warning', 'PAUSED': 'warning', 'BREACHED': 'danger', 'ESCALATED': 'danger', 'MET': 'success', 'NOT_SET': 'neutral'} %}

    <section class="ticket-layout">
        <div class="ticket-main">
            {# Header / Summary #}
            <section class="page-section panel-section">
                <div class="ticket-title-row">
                    <div>
                        <p class="section-kicker">{{ ticket.category.name }} · {{ ticket.department.name }}</p>
                        <h2>{{ ticket.subject }}</h2>
                        <p class="muted">Reference: <strong>{{ ticket.reference }}</strong></p>
                    </div>
                    <div class="badge-cluster">
                        {% include 'components/_badge.html.twig' with { label: ticket.status.label, tone: statusTones[ticket.status.value]|default('neutral') } only %}
                        {% include 'components/_badge.html.twig' with { label: ticket.slaStatus|replace({'_': ' '})|title, tone: slaTones[ticket.slaStatus]|default('neutral') } only %}
                    </div>
                </div>
                <p class="ticket-description">{{ ticket.description|nl2br }}</p>
            </section>

            {% set canAcceptTicket = ticket.status.value in ['OPEN', 'REOPENED'] and is_granted('ticket.assign', ticket) %}
            {% set canResolveTicket = ticket.status.value == 'IN_PROGRESS' and is_granted('ticket.reply', ticket) and app.user.hasPermission('resolve_tickets') %}
            {% set canCloseCurrentTicket = ticket.status.value == 'RESOLVED' and canCloseTicket %}
            {% set canReopenTicket = ticket.status.value in ['RESOLVED', 'CLOSED'] and is_granted('ticket.assign', ticket) %}
            {% if canAcceptTicket or canResolveTicket or canCloseCurrentTicket or canReopenTicket or ticket.status.value in ['RESOLVED', 'CLOSED'] %}
                <section id="ticket-workflow" class="page-section panel-section ticket-workflow">
                    <div class="section-header">
                        <div>
                            <p class="section-kicker">Ticket workflow</p>
                            <h2>{{ ticket.status.label }}</h2>
                        </div>
                    </div>

                    <div class="ticket-workflow__actions">
                        {% if ticket.status.value in ['RESOLVED', 'CLOSED'] %}
                            <div class="resolved-panel">
                                <div class="resolved-panel__icon">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                                    </svg>
                                </div>
                                <div class="resolved-panel__body">
                                    <strong>{{ ticket.status.value == 'CLOSED' ? 'Ticket Closed' : 'Ticket Resolved' }}</strong>
                                    {% set resolvedEntry = ticket.statusHistory|filter(h => h.toStatus.value in ['RESOLVED','CLOSED'])|last %}
                                    {% if resolvedEntry %}
                                        <p>{% if resolvedEntry.changedBy %}By <strong>{{ resolvedEntry.changedBy.fullName }}</strong> · {% endif %}{{ resolvedEntry.createdAt|date('M j, Y H:i') }}</p>
                                        {% if resolvedEntry.reason %}<p class="resolved-panel__meta">{{ resolvedEntry.reason }}</p>{% endif %}
                                    {% endif %}
                                </div>
                            </div>
                        {% endif %}

                        {% if canAcceptTicket %}
                            <form method="post" action="{{ path('ticket_accept', { id: ticket.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('ticket_accept_' ~ ticket.id) }}">
                                <button class="button button--primary" type="submit">Accept ticket</button>
                            </form>
                        {% endif %}

                        {% if canResolveTicket %}
                            <form class="stack-form compact-form" method="post" action="{{ path('ticket_resolve', { id: ticket.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('ticket_resolve_' ~ ticket.id) }}">
                                <label class="form-field">
                                    <span>Resolution summary *</span>
                                    <textarea class="input textarea" name="resolution" rows="3" required minlength="10" placeholder="Describe what was done to resolve this ticket..."></textarea>
                                </label>
                                <button class="button button--primary" type="submit">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                                        <polyline points="20 6 9 17 4 12"/>
                                    </svg>
                                    Mark as Resolved
                                </button>
                            </form>
                        {% endif %}

                        {% if canCloseCurrentTicket %}
                            <form method="post" action="{{ path('ticket_close', { id: ticket.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('ticket_close_' ~ ticket.id) }}">
                                <button class="button button--secondary" type="submit">Close ticket</button>
                            </form>
                        {% endif %}

                        {% if canReopenTicket %}
                            <form class="stack-form compact-form" method="post" action="{{ path('ticket_reopen', { id: ticket.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('ticket_reopen_' ~ ticket.id) }}">
                                <label class="form-field">
                                    <span>Reason for reopening</span>
                                    <textarea class="input textarea" name="reason" rows="2" minlength="5" placeholder="Explain why this ticket is being reopened..."></textarea>
                                </label>
                                <button class="button button--secondary" type="submit">Reopen ticket</button>
                            </form>
                        {% endif %}
                    </div>
                </section>
            {% endif %}

            {# Ticket Information, Assignment & SLA #}
            <section class="page-section panel-section">
                <div class="section-grid">
                    <div>
                        <p class="section-kicker">Ticket information</p>
                        <dl class="detail-list">
                            <div><dt>Department</dt><dd>{{ ticket.department.name }}</dd></div>
                            <div><dt>Category</dt><dd>{{ ticket.category.name }}</dd></div>
                            <div><dt>Priority</dt><dd>{{ ticket.priority.label }}</dd></div>
                            <div><dt>Channel</dt><dd>{{ ticket.channel ? ticket.channel.label : 'Not specified' }}</dd></div>
                            <div><dt>Created</dt><dd>{{ ticket.createdAt|date('M j, Y H:i') }}</dd></div>
                            <div><dt>Updated</dt><dd>{{ ticket.updatedAt|date('M j, Y H:i') }}</dd></div>
                        </dl>
                    </div>

                    <div>
                        <p class="section-kicker">Assignment</p>
                        <dl class="detail-list">
                            <div><dt>Assigned officer</dt><dd>{{ ticket.assignedTo ? ticket.assignedTo.fullName : 'Unassigned' }}</dd></div>
                            <div><dt>Accepted</dt><dd>{{ ticket.acceptedAt ? ticket.acceptedAt|date('M j, Y H:i') : 'Not accepted' }}</dd></div>
                            <div><dt>Logged by</dt><dd>{{ ticket.createdBy ? ticket.createdBy.fullName : 'System' }}</dd></div>
                        </dl>

                    </div>

                    <div>
                        <p class="section-kicker">SLA</p>
                        <dl class="detail-list">
                            <div><dt>SLA due</dt><dd>{{ ticket.slaDueAt ? ticket.slaDueAt|date('M j, Y H:i') : 'Not set' }}</dd></div>
                            <div><dt>SLA status</dt><dd>{{ ticket.slaStatus|replace({'_': ' '})|title }}</dd></div>
                            <div><dt>First response</dt><dd>{{ ticket.firstRespondedAt ? ticket.firstRespondedAt|date('M j, Y H:i') : 'Pending' }}</dd></div>
                        </dl>
                    </div>
                </div>
            </section>

            {# Conversation / Messages #}
            <section class="page-section panel-section">
                <div class="section-header">
                    <div>
                        <p class="section-kicker">Conversation</p>
                        <h2>Messages & Updates</h2>
                    </div>
                </div>

                <div class="timeline">
                    {% for message in ticket.messages %}
                        <article class="timeline-item {% if message.visibility.value == 'INTERNAL' %}internal{% endif %}">
                            <div class="timeline-meta">
                                <div>
                                    <strong>{{ message.author ? message.author.fullName : 'System' }}</strong>
                                    <span class="muted" style="margin-left: var(--space-2);">{{ message.createdAt|date('M j, Y H:i') }}</span>
                                </div>
                                {% if message.visibility.value == 'INTERNAL' %}
                                    <span class="badge badge--warn">INTERNAL NOTE</span>
                                {% else %}
                                    <span class="badge">CUSTOMER</span>
                                {% endif %}
                            </div>
                            <p>{{ message.body|nl2br }}</p>
                            {% set messageAttachments = ticket.attachments|filter(attachment => attachment.message and attachment.message.id.toRfc4122 == message.id.toRfc4122) %}
                            {% if messageAttachments is not empty %}
                                <div class="attachment-list">
                                    {% for attachment in messageAttachments %}
                                        <a class="attachment-link" href="{{ path('attachment_download', { id: attachment.id }) }}">{{ attachment.originalFilename }}</a>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </article>
                    {% else %}
                        {% include 'components/_empty_state.html.twig' with { title: 'No replies yet', message: 'Conversation history will appear after a member contact or staff response.' } only %}
                    {% endfor %}
                </div>

                {% if ticket.status.value != 'CLOSED' and is_granted('ticket.reply', ticket) %}
                    <form class="stack-form compact-form" method="post" action="{{ path('ticket_reply', { id: ticket.id }) }}" enctype="multipart/form-data">
                        <input type="hidden" name="_token" value="{{ csrf_token('ticket_reply_' ~ ticket.id) }}">

                        <div class="form-field">
                            <span>Response Type</span>
                            <div class="radio-row">
                                <label><input type="radio" name="visibility" value="PUBLIC" checked> Customer Communication</label>
                                <label><input type="radio" name="visibility" value="INTERNAL"> Internal Note</label>
                            </div>
                        </div>

                        <label class="form-field">
                            <span>Note / Message</span>
                            <textarea class="input textarea" name="body" rows="4" required placeholder="Write message or internal staff note..."></textarea>
                        </label>

                        <label class="form-field">
                            <span>Attachment</span>
                            <input class="input" name="attachment" type="file" accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx,.txt">
                        </label>
                        <button class="button button--primary" type="submit">Submit Response</button>
                    </form>
                {% endif %}
            </section>

            {# Attachments panel #}
            <section class="page-section panel-section">
                <div class="section-header">
                    <div>
                        <p class="section-kicker">Files</p>
                        <h2>Attachments</h2>
                    </div>
                </div>
                <div class="attachment-list attachment-list--panel">
                    {% for attachment in ticket.attachments %}
                        <a class="attachment-link" href="{{ path('attachment_download', { id: attachment.id }) }}">
                            {{ attachment.originalFilename }} <span class="muted">{{ (attachment.sizeBytes / 1024)|round(1) }} KB</span>
                        </a>
                    {% else %}
                        {% include 'components/_empty_state.html.twig' with { title: 'No attachments', message: 'Files attached to this ticket will appear here.' } only %}
                    {% endfor %}
                </div>
            </section>
        </div>

        <aside class="ticket-side">
            {# Customer information #}
            <section class="panel-section">
                <p class="section-kicker">Customer Information</p>
                <dl class="detail-list">
                    <div><dt>Customer</dt><dd><strong>{{ ticket.member.displayName }}</strong></dd></div>
                    <div><dt>Member number</dt><dd>{{ ticket.member.memberNumber }}</dd></div>
                    <div><dt>Phone</dt><dd>{{ ticket.member.primaryPhone ?? 'N/A' }}</dd></div>
                    <div><dt>Email</dt><dd>{{ ticket.member.email ?? 'N/A' }}</dd></div>
                    <div><dt>Home branch</dt><dd>{{ ticket.member.branch ? ticket.member.branch.name : 'Not set' }}</dd></div>
                </dl>
            </section>

            {# Assignment & Actions #}
            <section class="panel-section">
                <p class="section-kicker">Assignment</p>
                <dl class="detail-list">
                    <div><dt>Assigned officer</dt><dd>{{ ticket.assignedTo ? ticket.assignedTo.fullName : 'Unassigned' }}</dd></div>
                    <div><dt>Department</dt><dd>{{ ticket.department.name }}</dd></div>
                </dl>

                <div class="action-stack">

                    {# ── Reassign ─────────────────────────────── #}
                    {% if is_granted('ticket.assign', ticket) and app.user.hasPermission('reassign_tickets') and ticket.status.value not in ['CLOSED'] %}
                        <form class="stack-form compact-form" method="post" action="{{ path('ticket_reassign', { id: ticket.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('ticket_reassign_' ~ ticket.id) }}">
                            <label class="form-field">
                                <span>Reassign to</span>
                                <select class="input" name="assigned_to" required>
                                    <option value="">Select staff</option>
                                    {% for staff in availableStaff %}
                                        <option value="{{ staff.id }}"{% if ticket.assignedTo and ticket.assignedTo.id.toRfc4122 == staff.id.toRfc4122 %} selected{% endif %}>{{ staff.fullName }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label class="form-field">
                                <span>Team</span>
                                <select class="input" name="assigned_team">
                                    <option value="">No team</option>
                                    {% for team in availableTeams %}
                                        <option value="{{ team.id }}"{% if ticket.assignedTeam and ticket.assignedTeam.id.toRfc4122 == team.id.toRfc4122 %} selected{% endif %}>{{ team.name }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <button class="button button--secondary button--full" type="submit">Reassign</button>
                        </form>
                    {% endif %}

                    {# ── In-progress actions ───────────────────── #}
                    {% if is_granted('ticket.reply', ticket) and ticket.status.value == 'IN_PROGRESS' %}
                        <form class="stack-form compact-form" method="post" action="{{ path('ticket_request_info', { id: ticket.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('ticket_request_info_' ~ ticket.id) }}">
                            <label class="form-field">
                                <span>Request information from member</span>
                                <textarea class="input textarea" name="question" rows="3" placeholder="What information do you need?"></textarea>
                            </label>
                            <button class="button button--secondary button--full" type="submit">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                                </svg>
                                Request info
                            </button>
                        </form>

                    {% endif %}

                    {# ── Escalate ─────────────────────────────── #}
                    {% if is_granted('ticket.escalate', ticket) and not ticket.escalatedAt and app.user.hasPermission('escalate_tickets') and ticket.status.value not in ['RESOLVED','CLOSED'] %}
                        <form class="stack-form compact-form" method="post" action="{{ path('ticket_escalate', { id: ticket.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('ticket_escalate_' ~ ticket.id) }}">
                            <label class="form-field">
                                <span>Escalation reason</span>
                                <textarea class="input textarea" name="reason" rows="3" placeholder="Why is this being escalated?"></textarea>
                            </label>
                            <button class="button button--secondary button--full" type="submit">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
                                </svg>
                                Escalate
                            </button>
                        </form>
                    {% endif %}

                </div>
            </section>

            {# Status history #}
            <section class="panel-section">
                <p class="section-kicker">Status history</p>
                <div class="mini-timeline">
                    {% for history in ticket.statusHistory %}
                        <div>
                            <strong>{{ history.toStatus.label }}</strong>
                            <span>{{ history.createdAt|date('M j, Y H:i') }}</span>
                            {% if history.changedBy %}<small>{{ history.changedBy.fullName }}</small>{% endif %}
                            {% if history.reason %}<small>{{ history.reason }}</small>{% endif %}
                        </div>
                    {% endfor %}
                </div>
            </section>

            {# Audit history #}
            <section class="panel-section">
                <p class="section-kicker">Audit history</p>
                {% if auditLogs is defined and auditLogs is not empty %}
                    <table class="audit-table">
                        <thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Context</th></tr></thead>
                        <tbody>
                            {% for a in auditLogs %}
                                <tr>
                                    <td>{{ a.createdAt|date('M j, Y H:i') }}</td>
                                    <td>{{ a.actor ? a.actor.fullName : 'System' }}</td>
                                    <td>{{ a.action }}</td>
                                    <td><pre>{{ a.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    {% include 'components/_empty_state.html.twig' with { title: 'No audit records', message: 'System audit events for this ticket will appear here.' } only %}
                {% endif %}
            </section>
        </aside>
    </section>
{% endblock %}