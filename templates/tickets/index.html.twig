{% extends 'base.html.twig' %}

{% block title %}Tickets | {{ app_name }}{% endblock %}
{% block page_heading %}Ticket Queue{% endblock %}

{% block topbar_actions %}
    {% if is_granted('ROLE_STAFF') or is_granted('ROLE_SUPERVISOR') or is_granted('ROLE_ADMIN') or is_granted('ROLE_MEMBER') %}
        {% include 'components/_button_link.html.twig' with { href: path('ticket_new'), label: '+ Create Ticket', variant: 'primary' } only %}
    {% endif %}
{% endblock %}

{% block body %}
    {# ── Queue Summary Stat Cards ─────────────────────────────── #}
    {% if queueMetrics is defined %}
    <div class="metrics-grid" style="margin-bottom: var(--sp-4);">
        <a class="metric" href="{{ path('ticket_index', app.request.query.all|merge({'status': 'OPEN', 'page': 1})) }}">
            <div class="metric-icon metric-icon--warn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
            </div>
            <span>Open Tickets</span>
            <strong>{{ queueMetrics.open }}</strong>
        </a>

        <a class="metric" href="{{ path('ticket_index', app.request.query.all|merge({'status': 'IN_PROGRESS', 'page': 1})) }}">
            <div class="metric-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                    <polyline points="17 6 23 6 23 12"/>
                </svg>
            </div>
            <span>In Progress</span>
            <strong>{{ queueMetrics.in_progress }}</strong>
        </a>

        <a class="metric" href="{{ path('ticket_index', app.request.query.all|merge({'status': 'WAITING_FOR_MEMBER', 'page': 1})) }}">
            <div class="metric-icon metric-icon--info">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/>
                    <polyline points="12 7 12 12 15 14"/>
                </svg>
            </div>
            <span>Awaiting Member</span>
            <strong>{{ queueMetrics.waiting }}</strong>
        </a>

        <a class="metric" href="{{ path('ticket_index', app.request.query.all|merge({'status': 'RESOLVED', 'page': 1})) }}">
            <div class="metric-icon" style="background: #e0f2fe; color: #0284c7;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <span>Resolved / Closed</span>
            <strong>{{ queueMetrics.resolved }}</strong>
        </a>
    </div>
    {% endif %}

    {# ── Filters ─────────────────────────────────────────────── #}
    <section class="page-section">
        <form class="filter-bar filter-bar--wide" method="get" action="{{ path('ticket_index') }}">
            <label class="form-field compact-field">
                <span>Search</span>
                <input class="input" name="q" value="{{ app.request.query.get('q') }}" placeholder="Ticket, member, phone">
            </label>
            <label class="form-field compact-field">
                <span>Status</span>
                <select class="input" name="status">
                    <option value="">All statuses</option>
                    {% for status in statuses %}
                        <option value="{{ status.value }}"{% if app.request.query.get('status') == status.value %} selected{% endif %}>{{ status.label }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="form-field compact-field">
                <span>Priority</span>
                <select class="input" name="priority">
                    <option value="">All priorities</option>
                    {% for priority in priorities %}
                        <option value="{{ priority.value }}"{% if app.request.query.get('priority') == priority.value %} selected{% endif %}>{{ priority.label }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="form-field compact-field">
                <span>Branch</span>
                <select class="input" name="branch">
                    <option value="">All locations</option>
                    {% for branch in branches %}
                        <option value="{{ branch.id }}"{% if app.request.query.get('branch') == branch.id %} selected{% endif %}>{{ branch.name }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="form-field compact-field">
                <span>Channel</span>
                <select class="input" name="channel">
                    <option value="">All channels</option>
                    {% for channel in channels %}
                        <option value="{{ channel.value }}"{% if app.request.query.get('channel') == channel.value %} selected{% endif %}>{{ channel.label }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="form-field compact-field">
                <span>SLA</span>
                <select class="input" name="sla_status">
                    <option value="">All SLA states</option>
                    {% for slaStatus in slaStatuses %}
                        <option value="{{ slaStatus }}"{% if app.request.query.get('sla_status') == slaStatus %} selected{% endif %}>{{ slaStatus|replace({'_': ' '})|title }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="form-field compact-field">
                <span>Department</span>
                <select class="input" name="department">
                    <option value="">All departments</option>
                    {% for department in departments %}
                        <option value="{{ department.id }}"{% if app.request.query.get('department') == department.id %} selected{% endif %}>{{ department.name }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="form-field compact-field">
                <span>Assigned to</span>
                <select class="input" name="assigned_to">
                    <option value="">Any officer</option>
                    {% for staff in staffMembers %}
                        <option value="{{ staff.id }}"{% if app.request.query.get('assigned_to') == staff.id %} selected{% endif %}>{{ staff.fullName }}</option>
                    {% endfor %}
                </select>
            </label>
            <label class="checkbox-field filter-checkbox">
                <input type="checkbox" name="overdue" value="1"{% if app.request.query.get('overdue') %} checked{% endif %}>
                <span>Overdue only</span>
            </label>
            <button class="button button--secondary" type="submit">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
                </svg>
                Filter
            </button>
        </form>

        {# ── Tickets table ───────────────────────────────────── #}
        {% set statusTones = {'OPEN': 'warning', 'IN_PROGRESS': 'success', 'WAITING_FOR_MEMBER': 'warning', 'RESOLVED': 'neutral', 'CLOSED': 'neutral', 'REOPENED': 'warning'} %}
        {% set slaTones    = {'ON_TRACK': 'success', 'DUE_SOON': 'warning', 'PAUSED': 'warning', 'BREACHED': 'danger', 'ESCALATED': 'danger', 'MET': 'success', 'NOT_SET': 'neutral'} %}

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>
                            <span class="th-icon">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="7" width="18" height="10" rx="2"/></svg>
                            </span>
                            Ticket
                        </th>
                        <th>
                            <span class="th-icon">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                            </span>
                            Customer
                        </th>
                        <th>
                            <span class="th-icon">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
                            </span>
                            Dept / Channel
                        </th>
                        <th>
                            <span class="th-icon">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            </span>
                            Assigned
                        </th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>
                            <span class="th-icon">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/></svg>
                            </span>
                            SLA
                        </th>
                        <th>Updated</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                {% for ticket in tickets %}
                    {% set initials = ticket.member.displayName|split(' ')|map(w => w|slice(0, 1)|upper)|join('')|slice(0, 2) %}
                    {% set avatarClasses = ['', 'avatar--green', 'avatar--purple', 'avatar--amber', 'avatar--rose', 'avatar--slate'] %}
                    {% set avatarClass = avatarClasses[ticket.member.displayName|length % 5] %}
                    <tr>
                        <td>
                            <a class="table-link" href="{{ path('ticket_show', { id: ticket.id }) }}">{{ ticket.reference }}</a>
                            <br>
                            <span class="muted">{{ ticket.subject|length > 50 ? ticket.subject|slice(0,50) ~ '…' : ticket.subject }}</span>
                        </td>
                        <td>
                            <div class="member-cell">
                                <span class="avatar avatar--sm {{ avatarClass }}">{{ initials }}</span>
                                <div class="member-cell__info">
                                    <span class="member-cell__name">{{ ticket.member.displayName }}</span>
                                    <span class="member-cell__sub">{{ ticket.member.memberNumber }}</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span style="font-size:13px">{{ ticket.department.name }}</span>
                            <br>
                            {% if ticket.branch %}<span class="muted">{{ ticket.branch.name }}</span>{% endif %}
                            {% if ticket.channel %}<span class="muted"> · {{ ticket.channel.label }}</span>{% endif %}
                        </td>
                        <td>
                            {% if ticket.assignedTo %}
                                <div class="assignee-chip">
                                    <span class="avatar avatar--sm avatar--slate">{{ ticket.assignedTo.fullName|split(' ')|map(w => w|slice(0, 1)|upper)|join('')|slice(0, 2) }}</span>
                                    <span style="font-size:13px">{{ ticket.assignedTo.fullName }}</span>
                                </div>
                            {% else %}
                                <span class="muted" style="font-size:13px">Unassigned</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="badge badge--{{ ticket.priority.value in ['URGENT', 'HIGH'] ? 'danger' : 'neutral' }}">
                                <span class="sdot sdot--{{ ticket.priority.value in ['URGENT', 'HIGH'] ? 'danger' : 'neutral' }}"></span>
                                {{ ticket.priority.label }}
                            </span>
                        </td>
                        <td>
                            <span class="badge badge--{{ statusTones[ticket.status.value]|default('neutral') }}">
                                <span class="sdot sdot--{{ statusTones[ticket.status.value]|default('neutral') }}"></span>
                                {{ ticket.status.label }}
                            </span>
                        </td>
                        <td>{% include 'components/_badge.html.twig' with { label: ticket.slaStatus|replace({'_': ' '})|title, tone: slaTones[ticket.slaStatus]|default('neutral') } only %}</td>
                        <td><span class="muted">{{ ticket.updatedAt|date('M j, H:i') }}</span></td>
                        <td>
                            {% if ticket.status.value in ['OPEN', 'REOPENED'] and is_granted('ticket.assign', ticket) %}
                                <form method="post" action="{{ path('ticket_accept', { id: ticket.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('ticket_accept_' ~ ticket.id) }}">
                                    <button class="button button--primary button--small" type="submit">Accept</button>
                                </form>
                            {% elseif ticket.status.value == 'IN_PROGRESS' and app.user.hasPermission('resolve_tickets') and is_granted('ticket.reply', ticket) %}
                                <a class="button button--primary button--small" href="{{ path('ticket_show', { id: ticket.id }) }}#ticket-workflow">Resolve</a>
                            {% else %}
                                <a class="button button--secondary button--small" href="{{ path('ticket_show', { id: ticket.id }) }}">Open</a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    {% include 'components/_table_empty.html.twig' with { colspan: 9, title: 'No matching tickets', message: 'Adjust your filters or create a new customer ticket.' } only %}
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="pagination-row">
            <span class="muted">{{ total }} result{{ total == 1 ? '' : 's' }}</span>
            <div class="row-actions">
                {% if page > 1 %}
                    <a class="button button--secondary button--small" href="{{ path('ticket_index', app.request.query.all|merge({ page: page - 1 })) }}">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><polyline points="15 18 9 12 15 6"/></svg>
                        Previous
                    </a>
                {% endif %}
                <span class="muted">Page {{ page }} of {{ pages }}</span>
                {% if page < pages %}
                    <a class="button button--secondary button--small" href="{{ path('ticket_index', app.request.query.all|merge({ page: page + 1 })) }}">
                        Next
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}