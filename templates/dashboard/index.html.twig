{% extends 'base.html.twig' %}

{% block title %}Dashboard | {{ app_name }}{% endblock %}
{% block page_heading %}Dashboard{% endblock %}

{% block topbar_actions %}
    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_MEMBER') or ((is_granted('ROLE_STAFF') or is_granted('ROLE_SUPERVISOR')) and app.user.hasPermission('create_tickets')) %}
        {% include 'components/_button_link.html.twig' with { href: path('ticket_new'), label: 'Create ticket', variant: 'primary' } only %}
    {% endif %}
{% endblock %}

{% block body %}

    {# ── Stat cards ──────────────────────────────────────────── #}
    <div class="metrics-grid">
        <div class="metric">
            <div class="metric-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
                    <rect x="9" y="3" width="6" height="4" rx="1"/>
                    <line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="12" y2="16"/>
                </svg>
            </div>
            <span>My open</span>
            <strong>{{ metrics.in_progress + metrics.open }}</strong>
        </div>

        <div class="metric">
            <div class="metric-icon metric-icon--warn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15 14"/>
                </svg>
            </div>
            <span>Awaiting action</span>
            <strong>{{ metrics.waiting }}</strong>
        </div>

        <div class="metric">
            <div class="metric-icon metric-icon--danger">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                    <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
            </div>
            <span>Overdue</span>
            <strong>{{ metrics.overdue }}</strong>
        </div>

        <div class="metric">
            <div class="metric-icon metric-icon--danger">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
                    <polyline points="17 6 23 6 23 12"/>
                </svg>
            </div>
            <span>Escalated</span>
            <strong>{{ metrics.escalated }}</strong>
        </div>
    </div>

    {# ── Supervisor workload panel ────────────────────────────── #}
    {% if is_granted('ROLE_SUPERVISOR') or is_granted('ROLE_ADMIN') %}
        <section class="page-section">
            <div class="section-header">
                <div>
                    <p class="section-kicker">Oversight</p>
                    <h2>Workload overview</h2>
                </div>
            </div>
            <div class="workload-grid">
                <div class="panel-section">
                    <h3 style="display:flex;align-items:center;gap:8px;margin-top:0">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                        </svg>
                        Department workload
                    </h3>
                    <div class="mini-report">
                        {% for label, count in metrics.groups.department|slice(0, 6) %}
                            <div>
                                <span>{{ label }}</span>
                                <strong>{{ count }}</strong>
                            </div>
                        {% else %}
                            <p class="muted">No department data yet.</p>
                        {% endfor %}
                    </div>
                </div>

                <div class="panel-section">
                    <h3 style="display:flex;align-items:center;gap:8px;margin-top:0">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        Alerts
                    </h3>
                    <div class="alert-panel">
                        <div class="alert-panel__row">
                            <span>Unassigned tickets</span>
                            <strong>{{ metrics.groups.staff['Unassigned'] ?? 0 }}</strong>
                        </div>
                        <div class="alert-panel__row">
                            <span>Critical priority</span>
                            <strong>{{ metrics.critical }}</strong>
                        </div>
                        <div class="alert-panel__row">
                            <span>Escalated</span>
                            <strong>{{ metrics.escalated }}</strong>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    {% endif %}

    {# ── Breakdown report panels ──────────────────────────────── #}
    <section class="report-grid">
        {% for title, group in {'Department': metrics.groups.department, 'Category': metrics.groups.category, 'Priority': metrics.groups.priority, 'Staff': metrics.groups.staff, 'Date': metrics.groups.date} %}
            <section class="panel-section report-panel">
                <p class="section-kicker">Breakdown</p>
                <h2>{{ title }}</h2>
                <div class="mini-report">
                    {% for label, count in group|slice(0, 6) %}
                        <div><span>{{ label }}</span><strong>{{ count }}</strong></div>
                    {% else %}
                        <p class="muted">No data yet.</p>
                    {% endfor %}
                </div>
            </section>
        {% endfor %}
    </section>

    {# ── Recent tickets table ─────────────────────────────────── #}
    <section class="page-section">
        <div class="section-header">
            <div>
                <p class="section-kicker">Operational queue</p>
                <h2>Recent tickets</h2>
            </div>
            {% include 'components/_button_link.html.twig' with { href: path('ticket_index'), label: 'View all', variant: 'secondary' } only %}
        </div>

        {% set statusTones = {'OPEN': 'warning', 'IN_PROGRESS': 'success', 'WAITING_FOR_MEMBER': 'warning', 'RESOLVED': 'neutral', 'CLOSED': 'neutral', 'REOPENED': 'warning'} %}
        {% set statusDots  = {'OPEN': 'warning', 'IN_PROGRESS': 'success', 'WAITING_FOR_MEMBER': 'warning', 'RESOLVED': 'neutral', 'CLOSED': 'neutral', 'REOPENED': 'warning'} %}
        {% set slaTones    = {'ON_TRACK': 'success', 'DUE_SOON': 'warning', 'PAUSED': 'warning', 'BREACHED': 'danger', 'ESCALATED': 'danger', 'MET': 'success', 'NOT_SET': 'neutral'} %}

        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>
                            <span class="th-icon">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="7" width="18" height="10" rx="2"/></svg>
                            </span>
                            Ticket
                        </th>
                        <th>
                            <span class="th-icon">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                            </span>
                            Member
                        </th>
                        <th>Department</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Resolved by</th>
                        <th>SLA</th>
                        <th>Updated</th>
                        <th>Action</th>
                    </tr>
                </thead>
                        <td>
                            {% if ticket.status.value in ['OPEN', 'REOPENED'] and is_granted('ticket.assign', ticket) %}
                                <form method="post" action="{{ path('ticket_accept', { id: ticket.id }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('ticket_accept_' ~ ticket.id) }}">
                                    <button class="button button--primary button--small" type="submit">Accept</button>
                                </form>
                            {% elseif ticket.status.value == 'IN_PROGRESS' and app.user.hasPermission('resolve_tickets') and is_granted('ticket.reply', ticket) %}
                                <a class="button button--primary button--small" href="{{ path('ticket_show', { id: ticket.id }) }}#ticket-workflow">Resolve</a>
                            {% else %}
                                <a class="button button--secondary button--small" href="{{ path('ticket_show', { id: ticket.id }) }}">Open</a>
                            {% endif %}
                        </td>
                <tbody>
                {% for ticket in recentTickets %}
                    {% include 'components/_table_empty.html.twig' with { colspan: 9, title: 'No tickets yet', message: is_granted('ROLE_MEMBER') ? 'Create your first support ticket when you need help.' : 'Tickets assigned to your department will appear here.' } only %}
                    {% set resolvedEntry = ticket.statusHistory|filter(h => h.toStatus.value == 'RESOLVED')|last %}
                    <tr>
                        <td>
                            <a class="table-link" href="{{ path('ticket_show', { id: ticket.id }) }}">{{ ticket.reference }}</a>
                            <br><span class="muted">{{ ticket.subject|length > 48 ? ticket.subject|slice(0,48) ~ '…' : ticket.subject }}</span>
                        </td>
                        <td>
                            <div class="member-cell">
                                <span class="avatar avatar--sm">{{ initials }}</span>
                                <span class="member-cell__name">{{ ticket.member.displayName }}</span>
                            </div>
                        </td>
                        <td><span class="muted">{{ ticket.department.name }}</span></td>
                        <td>
                            <span class="badge badge--{{ ticket.priority.value in ['URGENT','HIGH'] ? 'danger' : 'neutral' }}">
                                <span class="sdot sdot--{{ ticket.priority.value in ['URGENT','HIGH'] ? 'danger' : 'neutral' }}"></span>
                                {{ ticket.priority.label }}
                            </span>
                        </td>
                        <td>
                            <span class="badge badge--{{ statusTones[ticket.status.value]|default('neutral') }}">
                                <span class="sdot sdot--{{ statusTones[ticket.status.value]|default('neutral') }}"></span>
                                {{ ticket.status.label }}
                            </span>
                        </td>
                        <td>
                            {% if resolvedEntry and resolvedEntry.changedBy %}
                                <span class="muted">{{ resolvedEntry.changedBy.fullName }}</span>
                            {% else %}
                                <span class="muted">-</span>
                            {% endif %}
                        </td>
                        <td>{% include 'components/_badge.html.twig' with { label: ticket.slaStatus|replace({'_': ' '})|title, tone: slaTones[ticket.slaStatus]|default('neutral') } only %}</td>
                        <td><span class="muted">{{ ticket.updatedAt|date('M j, H:i') }}</span></td>
                    </tr>
                {% else %}
                    {% include 'components/_table_empty.html.twig' with { colspan: 8, title: 'No tickets yet', message: is_granted('ROLE_MEMBER') ? 'Create your first support ticket when you need help.' : 'Tickets assigned to your department will appear here.' } only %}
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>

{% endblock %}