<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Sign In | {{ app_name|default('NZERU Help Desk') }}{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --accent: #0D7A5F;
            --accent-dark: #085C47;
            --accent-glow: rgba(13, 122, 95, 0.25);
            --ink: #111827;
            --muted: #6B7280;
            --border: #E5E7EB;
            --surface: #ffffff;
            --page: #F0F4F2;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            background: var(--page);
            background-image:
                radial-gradient(ellipse 80% 60% at 50% 0%, rgba(13,122,95,0.10) 0%, transparent 70%),
                radial-gradient(ellipse 40% 40% at 80% 80%, rgba(13,122,95,0.06) 0%, transparent 60%);
            -webkit-font-smoothing: antialiased;
            padding: 24px;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: var(--surface);
            border-radius: 20px;
            padding: 48px 44px 44px;
            box-shadow:
                0 0 0 1px rgba(0,0,0,0.05),
                0 4px 6px rgba(0,0,0,0.04),
                0 20px 40px rgba(0,0,0,0.08);
            animation: slideUp .35s cubic-bezier(.16,1,.3,1) both;
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(18px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* --- Logo / brand ----------------------------------- */
        .brand-center {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            margin-bottom: 32px;
        }

        .logo-wrap {
            width: 72px;
            height: 72px;
            background: transparent;
            display: grid;
            place-items: center;
        }

        .logo-wrap img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            filter: drop-shadow(0 4px 10px rgba(0,0,0,0.06));
        }

        .logo-initials {
            font-size: 30px;
            font-weight: 800;
            color: #fff;
            letter-spacing: -1px;
        }

        .brand-name {
            text-align: center;
            line-height: 1.25;
        }

        .brand-name strong {
            display: block;
            font-size: 20px;
            font-weight: 800;
            color: var(--ink);
            letter-spacing: -0.3px;
        }

        .brand-name span {
            font-size: 13px;
            color: var(--muted);
            font-weight: 400;
        }

        /* --- Heading ---------------------------------------- */
        .login-heading {
            text-align: center;
            margin-bottom: 28px;
        }

        .login-heading h1 {
            font-size: 18px;
            font-weight: 700;
            color: var(--ink);
            margin-bottom: 4px;
        }

        .login-heading p {
            font-size: 13px;
            color: var(--muted);
        }

        /* --- Error state ------------------------------------ */
        .error-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #FEF2F2;
            border: 1px solid #FECACA;
            border-radius: 10px;
            padding: 12px 14px;
            margin-bottom: 22px;
            font-size: 13px;
            color: #B91C1C;
        }

        .error-box svg { flex-shrink: 0; }

        /* --- Form ------------------------------------------- */
        .field {
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-bottom: 16px;
        }

        .field label {
            font-size: 13px;
            font-weight: 600;
            color: var(--ink);
        }

        .field input {
            width: 100%;
            height: 46px;
            padding: 0 14px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-size: 14px;
            font-family: inherit;
            color: var(--ink);
            background: #FAFAFA;
            transition: border-color .15s, box-shadow .15s, background .15s;
            outline: none;
        }

        .field input:focus {
            border-color: var(--accent);
            background: #fff;
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

        .field input::placeholder { color: #9CA3AF; }

        /* --- Submit ----------------------------------------- */
        .btn-submit {
            width: 100%;
            height: 48px;
            margin-top: 8px;
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            letter-spacing: 0.01em;
            box-shadow: 0 4px 14px var(--accent-glow);
            transition: background .15s, transform .1s, box-shadow .15s;
        }

        .btn-submit:hover {
            background: var(--accent-dark);
            box-shadow: 0 6px 20px var(--accent-glow);
        }

        .btn-submit:active { transform: scale(0.985); }

        /* --- Footer links ----------------------------------- */
        .login-links {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 22px;
        }

        .login-links a {
            font-size: 13px;
            color: var(--accent);
            font-weight: 500;
            text-decoration: none;
            transition: color .12s;
        }

        .login-links a:hover { color: var(--accent-dark); text-decoration: underline; }

        /* --- Footer ----------------------------------------- */
        .login-footer {
            text-align: center;
            margin-top: 28px;
            font-size: 12px;
            color: var(--muted);
        }

        @media (max-width: 480px) {
            .login-card { padding: 36px 24px 32px; border-radius: 16px; }
        }
    </style>
</head>
<body>

<div class="login-card">

    {# Centered logo + brand name #}
    <div class="brand-center">
        <div class="logo-wrap">
            {% if app_logo_path is defined and app_logo_path %}
                {% set loginLogo = app_logo_path matches '/logonzeru/' ? 'assets/styles/logonzeru.png' : app_logo_path %}
                <img src="{{ asset(loginLogo) }}" alt="{{ app_short_name|default('NZERU') }} logo">
            {% else %}
                <span class="logo-initials">{{ app_short_name|default('NZ')|slice(0,2)|upper }}</span>
            {% endif %}
        </div>
        <div class="brand-name">
            <strong>{{ app_name|default('NZERU Help Desk') }}</strong>
            <span>{{ app_tagline|default('Member & Staff Support') }}</span>
        </div>
    </div>

    <div class="login-heading">
        <h1>Welcome back</h1>
        <p>Sign in to your account to continue</p>
    </div>

    {% if error %}
        <div class="error-box" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <form method="post" action="{{ path('app_login') }}" novalidate>
        <div class="field">
            <label for="username">Email address</label>
            <input
                type="email"
                id="username"
                name="_username"
                value="{{ last_username }}"
                placeholder="you@example.com"
                autocomplete="email"
                required
                autofocus
            >
        </div>

        <div class="field">
            <label for="password">Password</label>
            <input
                type="password"
                id="password"
                name="_password"
                placeholder="••••••••"
                autocomplete="current-password"
                required
            >
        </div>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn-submit" type="submit">Sign in</button>
    </form>

    <div class="login-links">
        <a href="{{ path('password_request') }}">Forgot password?</a>
        <a href="{{ path('member_register') }}">Register account</a>
    </div>

    <div class="login-footer">
        &copy; {{ "now"|date("Y") }} Mudi SACCO · All rights reserved
    </div>

</div>

</body>
</html>